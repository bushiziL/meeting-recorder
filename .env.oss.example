# 阿里云 OSS 部署配置
# 复制此文件为 .env.oss 并填写你的信息

# OSS 地域（Bucket 所在区域）
# 常用值: oss-cn-hangzhou, oss-cn-shanghai, oss-cn-beijing, oss-cn-shenzhen
OSS_REGION=oss-cn-hangzhou

# Bucket 名称（在 OSS 控制台创建时填写的名字）
OSS_BUCKET=meeting-recorder

# AccessKey ID（阿里云 AccessKey 管理: https://ram.console.aliyun.com/manage/ak）
OSS_AK=your-access-key-id

# AccessKey Secret
OSS_SK=your-access-key-secret

# 自定义域名（可选，部署成功后显示访问地址）
CUSTOM_DOMAIN=mvpskill.cn
